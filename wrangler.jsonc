{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app-estudos-concurso-gemini",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/ai/*",
      "/vendor/*",
      "/",
      "/index.html",
      "/sw.js",
      "/pwa-update.js",
      "/app.js",
      "/app.css",
      "/version.json"
    ],
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SUPABASE_URL": "https://vqtcveixmwiaoweimdik.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZxdGN2ZWl4bXdpYW93ZWltZGlrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU5MzA4ODgsImV4cCI6MjEwMTUwNjg4OH0._8OOEdGbvDK1Vh_af2FJJn0-EVFjJjGZ_krQ6ue6V6c"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "96566001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
